{
  "name": "@agentfs/cli",
  "version": "0.0.2",
  "description": "Cloud storage for AI agents from the terminal. Upload a file, get a link.",
  "license": "MIT",
  "homepage": "https://agentfs.cloud",
  "type": "module",
  "keywords": [
    "ai-agents",
    "file-storage",
    "cli",
    "mcp",
    "claude-code",
    "uploads"
  ],
  "bin": {
    "agentfs": "dist/agentfs.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target node --minify --outfile dist/agentfs.js && chmod +x dist/agentfs.js && mkdir -p dist/skills && cp -R ../../skills/. dist/skills/",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/agentfs.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
