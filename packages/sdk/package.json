{
  "name": "@agentfs/sdk",
  "version": "1.0.0",
  "description": "Cloud storage for AI agents. A drop-in for Turso's agentfs-sdk, backed by agentfs.",
  "license": "MIT",
  "homepage": "https://agentfs.cloud",
  "type": "module",
  "keywords": [
    "ai-agents",
    "agentfs",
    "file-storage",
    "sdk",
    "key-value",
    "tool-calls"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/agentfs.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
