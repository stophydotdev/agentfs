{
  "name": "@agentfs/sdk",
  "version": "0.0.1",
  "description": "Upstash Blob-style SDK for AgentFS: Bucket put/get/list/del/copy/move, signed URLs, browser uploads and a React hook.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/agentfs.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.agentfs.cloud",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/browser.ts src/react.ts --outdir dist --target browser --format esm --splitting --external zod --external react && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "19",
    "react": "19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.12"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
