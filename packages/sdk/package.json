{
  "name": "@agentfs/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for AgentFS: upload files, get links, manage them from any runtime with fetch.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/stophydotdev/agentfs.git", "directory": "packages/sdk" },
  "homepage": "https://docs.agentfs.cloud",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --external zod && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=20.12" }
}
